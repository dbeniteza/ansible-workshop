# This file is managed by Ansible.
# Manual changes may be overwritten.

user nginx;
worker_processes {{ nginx_worker_processes }};

events {
    worker_connections {{ nginx_worker_connections }};
}

http {
{% if nginx_access_log_enabled | bool %}
    access_log /var/log/nginx/access.log;
{% else %}
    access_log off;
{% endif %}

    upstream {{ nginx_upstream_name }} {
{% for backend in nginx_backend_servers %}
        server {{ backend.address }}:{{ backend.port }};
{% endfor %}
    }

    server {
        listen {{ nginx_web_port }};
        server_name {{ nginx_server_name }};

        location / {
            proxy_pass http://{{ nginx_upstream_name }};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            access_log off;
            default_type text/plain;
            return 200 "Environment: {{ nginx_environment }}\n";
        }
    }
}
